# Copy to .env and fill in real values before deploying.

# Funded EOA on Arbitrum Sepolia (and One when deploying to mainnet).
# Get testnet ETH from https://faucet.quicknode.com/arbitrum/sepolia
DEPLOYER_PRIVATE_KEY=0x...

# The tollkit-sms seller wallet — authorized to call recordSpend() on the
# deployed ConsentMandateRegistry. This is the same address as PAY_TO_ADDRESS
# in x402-sms-server's .env.
SELLER_ADDRESS=0x60725F59CC7C300cb40360C804D053066966CfcD

# RPC endpoints. Public Arbitrum endpoints work for the buildathon;
# upgrade to Alchemy / Infura for production rate limits.
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC=https://arb1.arbitrum.io/rpc

# Arbiscan API key for `forge script --verify` post-deployment verification.
# Get one at https://arbiscan.io/myapikey (free tier is fine).
ARBISCAN_API_KEY=
